{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "injectionSelector": "L:source.js -comment, L:source.ts -comment, L:source.jsx -comment, L:source.tsx -comment, L:text.html -comment, L:source.svelte -comment",
  "name": "tailwindcss syntax highlighting",
  "patterns": [
    { "include": "#class-attribute-array" },
    { "include": "#class-attribute-object" },
    { "include": "#singleline-class-attribute" },
    { "include": "#multiline-class-attribute" },
    { "include": "#class-attribute-expression" }
  ],
  "repository": {
    "braces": {
      "captures": {
        "1": {
          "name": "punctuation.definition.block.tailwindcss"
        }
      },
      "match": "([{}])"
    },
    "class-attribute-array": {
      "begin": "(?<!const\\s|let\\s|var\\s|\\.)\\b(class|className)\\b\\s*(=)\\s*({)\\s*(\\[)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.tailwindcss"
        },
        "2": {
          "name": "keyword.operator.assignment.tailwindcss"
        },
        "3": {
          "patterns": [
            { "include": "#braces" }
          ]
        },
        "4": {
          "name": "meta.brace.square.tailwindcss"
        }
      },
      "end": "(\\])\\s*(})",
      "endCaptures": {
        "1": {
          "name": "meta.brace.square.tailwindcss"
        },
        "2": {
          "patterns": [
            { "include": "#braces" }
          ]
        }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#comparison-string" },
        { "include": "#quoted-class-string" },
        { "include": "#class-object" },
        { "include": "#commas" },
        { "include": "#js-tokens" }
      ]
    },
    "class-attribute-expression": {
      "begin": "(?<!const\\s|let\\s|var\\s|\\.)\\b(class|className)\\b\\s*(=)\\s*({)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.tailwindcss"
        },
        "2": {
          "name": "keyword.operator.assignment.tailwindcss"
        },
        "3": {
          "patterns": [
            { "include": "#braces" }
          ]
        }
      },
      "end": "(})",
      "endCaptures": {
        "1": {
          "patterns": [
            { "include": "#braces" }
          ]
        }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#comparison-string" },
        { "include": "#quoted-class-string" },
        { "include": "#interpolation" },
        { "include": "#parenthesis" },
        { "include": "#commas" },
        { "include": "#js-tokens" }
      ]
    },
    "class-attribute-object": {
      "begin": "\\b(class|className)\\b\\s*(=)\\s*({)\\s*({)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.tailwindcss"
        },
        "2": {
          "name": "keyword.operator.assignment.tailwindcss"
        },
        "3": {
          "patterns": [
            { "include": "#braces" }
          ]
        },
        "4": {
          "name": "punctuation.definition.dictionary.begin.tailwindcss"
        }
      },
      "end": "(})\\s*(})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.dictionary.end.tailwindcss"
        },
        "2": {
          "patterns": [
            { "include": "#braces" }
          ]
        }
      },
      "patterns": [
        { "include": "#class-object-entries" }
      ]
    },
    "class-object": {
      "begin": "({)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.dictionary.begin.tailwindcss"
        }
      },
      "end": "(})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.dictionary.end.tailwindcss"
        }
      },
      "patterns": [
        { "include": "#class-object-entries" }
      ]
    },
    "class-object-entries": {
      "patterns": [
        { "include": "#comments" },
        {
          "captures": {
            "1": {
              "name": "string.quoted.tailwindcss",
              "patterns": [
                { "include": "#quotes" }
              ]
            },
            "2": {
              "patterns": [
                { "include": "#multi-class-string-without-quotes" }
              ]
            },
            "3": {
              "name": "string.quoted.tailwindcss",
              "patterns": [
                { "include": "#quotes" }
              ]
            }
          },
          "match": "([\"'`])(.*?)(\\1)(?=\\s*:)"
        },
        {
          "captures": {
            "1": {
              "patterns": [
                { "include": "#tailwindcss-class-with-variants" }
              ]
            }
          },
          "match": "([\\w-]+)(?=\\s*:)"
        },
        { "include": "#comparison-string" },
        { "include": "#quoted-class-string" },
        { "include": "#commas" },
        { "include": "#js-tokens" }
      ]
    },
    "commas": {
      "captures": {
        "1": {
          "name": "punctuation.separator.comma.tailwindcss"
        }
      },
      "match": "(,)"
    },
    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.tailwindcss"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.tailwindcss"
            }
          },
          "name": "comment.block.tailwindcss"
        },
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.tailwindcss"
            }
          },
          "match": "(//).*$",
          "name": "comment.line.double-slash.tailwindcss"
        }
      ]
    },
    "comparison-string": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword.operator.tailwindcss"
            },
            "2": {
              "name": "string.quoted.tailwindcss"
            }
          },
          "match": "(===|!==|==|!=)\\s*('[^']*'|\"[^\"]*\"|`[^`]*`)"
        },
        {
          "match": "('[^']*'|\"[^\"]*\"|`[^`]*`)(?=\\s*(?:===|!==|==|!=))",
          "name": "string.quoted.tailwindcss"
        }
      ]
    },
    "css-current-color": {
      "captures": {
        "1": {
          "name": "support.constant.color.current.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "color-current.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "(currentColor)"
    },
    "css-functions": {
      "captures": {
        "1": {
          "name": "support.function.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "function.custom.tailwindcss"
            }
          ]
        },
        "2": {
          "name": "punctuation.section.function.begin.bracket.round.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "parenthesis.custom.tailwindcss"
            }
          ]
        },
        "3": {
          "patterns": [
            { "include": "#css-variables" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "include": "#commas" },
            { "include": "#parenthesis" },
            { "include": "#whitespace" },
            { "include": "#quoted-string" },
            { "include": "#css-functions" },
            { "include": "#css-selectors" }
          ]
        },
        "4": {
          "name": "punctuation.section.function.end.bracket.round.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "parenthesis.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "([\\w-]+)(\\()(.*)(\\))"
    },
    "css-selectors": {
      "captures": {
        "1": {
          "name": "keyword.operator.combinator.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "selector.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "([>+~&\\*])"
    },
    "css-variables": {
      "captures": {
        "1": {
          "name": "variable.argument.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "css-variable.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "(-{2}[\\w-]+)"
    },
    "interpolation": {
      "begin": "(\\$\\{|\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.tailwindcss"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.end.tailwindcss"
        }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#comparison-string" },
        { "include": "#quoted-class-string" },
        { "include": "#interpolation" },
        { "include": "#commas" },
        { "include": "#js-tokens" }
      ]
    },
    "js-tokens": {
      "patterns": [
        {
          "match": "\\b(true|false|null|undefined)\\b",
          "name": "constant.language.tailwindcss"
        },
        {
          "match": "[0-9]+(\\.[0-9]+)?",
          "name": "constant.numeric.tailwindcss"
        },
        {
          "match": "===|!==|==|!=|&&|\\|\\||\\?\\?|[?:!]",
          "name": "keyword.operator.tailwindcss"
        },
        {
          "match": "[\\w$]+(?=\\s*\\()",
          "name": "entity.name.function.tailwindcss"
        },
        {
          "match": "[\\w$]+",
          "name": "variable.other.readwrite.tailwindcss"
        }
      ]
    },
    "multi-class-string-without-quotes": {
      "captures": {
        "1": {
          "patterns": [
            { "include": "#tailwindcss-class-with-variants" }
          ]
        }
      },
      "match": "((?:[^\\s\"'`]|[\"'`](?![\\s>}/]|$))+)"
    },
    "multiline-class-attribute": {
      "begin": "\\b(class|className)\\b\\s*(=)\\s*({)?\\s*([\"'`])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.tailwindcss"
        },
        "2": {
          "name": "keyword.operator.assignment.tailwindcss"
        },
        "3": {
          "patterns": [
            { "include": "#braces" }
          ]
        },
        "4": {
          "patterns": [
            { "include": "#quotes" }
          ]
        }
      },
      "end": "(\\4)\\s*(})?",
      "endCaptures": {
        "1": {
          "patterns": [
            { "include": "#quotes" }
          ]
        },
        "2": {
          "patterns": [
            { "include": "#braces" }
          ]
        }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#multi-class-string-without-quotes" }
      ]
    },
    "numbers": {
      "captures": {
        "1": {
          "name": "constant.numeric.decimal.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "number.custom.tailwindcss"
            }
          ]
        },
        "2": {
          "name": "constant.numeric.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "unit.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "([0-9]+)([a-zA-Z%]+)?"
    },
    "operators": {
      "captures": {
        "1": {
          "name": "keyword.operator.arithmetic.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "operator.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "([/*+-])"
    },
    "parenthesis": {
      "patterns": [
        {
          "match": "(\\()",
          "name": "punctuation.section.parens.begin.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "parenthesis.custom.tailwindcss"
            }
          ]
        },
        {
          "match": "(\\))",
          "name": "punctuation.section.parens.end.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "parenthesis.custom.tailwindcss"
            }
          ]
        }
      ]
    },
    "quoted-class-string": {
      "captures": {
        "1": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            { "include": "#quotes" }
          ]
        },
        "2": {
          "patterns": [
            { "include": "#interpolation" },
            { "include": "#multi-class-string-without-quotes" }
          ]
        },
        "3": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            { "include": "#quotes" }
          ]
        }
      },
      "match": "([\"'`])(.*?)(\\1)"
    },
    "quoted-string": {
      "captures": {
        "1": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "string.custom.tailwindcss"
            }
          ]
        },
        "2": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "string.custom.tailwindcss"
            }
          ]
        },
        "3": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "string.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "([\"'`])(.*)(\\1)"
    },
    "quotes": {
      "patterns": [
        {
          "match": "(\")",
          "name": "string.quoted.double.tailwindcss"
        },
        {
          "match": "(')",
          "name": "string.quoted.single.tailwindcss"
        },
        {
          "match": "(`)",
          "name": "string.quoted.backtick.tailwindcss"
        }
      ]
    },
    "singleline-class-attribute": {
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.tailwindcss"
        },
        "2": {
          "name": "keyword.operator.assignment.tailwindcss"
        },
        "3": {
          "name": "punctuation.definition.block.tailwindcss"
        },
        "4": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            { "include": "#quotes" }
          ]
        },
        "5": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            { "include": "#interpolation" },
            {
              "captures": {
                "1": {
                  "patterns": [
                    {
                      "include": "#tailwindcss-class-with-variants"
                    }
                  ]
                }
              },
              "match": "([^\\s]+)"
            }
          ]
        },
        "6": {
          "name": "string.quoted.tailwindcss",
          "patterns": [
            { "include": "#quotes" }
          ]
        },
        "7": {
          "name": "punctuation.definition.block.tailwindcss"
        }
      },
      "match": "\\b(class|className)\\b\\s*(=)\\s*({)?\\s*([\"'`])\\s*(.*?)\\s*(\\4)(?:\\s*(?=\\s*}))?(})?"
    },
    "slash": {
      "captures": {
        "1": {
          "name": "keyword.operator.arithmetic.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "operator.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "(/)"
    },
    "tailwindcss-bracketed-styles": {
      "captures": {
        "1": {
          "name": "meta.brace.square.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "bracket.custom.tailwindcss"
            }
          ]
        },
        "2": {
          "patterns": [
            {
              "captures": {
                "1": {
                  "name": "support.type.property-name.css.tailwindcss",
                  "patterns": [
                    {
                      "match": "(.*)",
                      "name": "property-name.custom.tailwindcss"
                    }
                  ]
                },
                "2": {
                  "name": "keyword.operator.assignment.tailwindcss"
                },
                "3": {
                  "patterns": [
                    {
                      "captures": {
                        "1": {
                          "name": "property-value.custom.tailwindcss",
                          "patterns": [
                            { "include": "#css-variables" },
                            { "include": "#css-current-color" },
                            { "include": "#numbers" },
                            { "include": "#operators" },
                            { "include": "#commas" },
                            { "include": "#parenthesis" },
                            { "include": "#whitespace" },
                            { "include": "#quoted-string" },
                            { "include": "#css-functions" },
                            { "include": "#css-selectors" }
                          ]
                        }
                      },
                      "match": "(.*)",
                      "name": "support.constant.property-value.css.tailwindcss"
                    }
                  ]
                }
              },
              "match": "([\\w-]+)(:)(.*)"
            },
            { "include": "#css-variables" },
            { "include": "#css-current-color" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "include": "#commas" },
            { "include": "#parenthesis" },
            { "include": "#whitespace" },
            { "include": "#quoted-string" },
            { "include": "#css-functions" },
            { "include": "#css-selectors" }
          ]
        },
        "3": {
          "name": "meta.brace.square.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "brackets.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "(\\[)(.*)(\\])"
    },
    "tailwindcss-class": {
      "captures": {
        "1": {
          "name": "class.custom.tailwindcss",
          "patterns": [
            { "include": "#tailwindcss-bracketed-styles" },
            { "include": "#numbers" },
            { "include": "#css-functions" },
            { "include": "#slash" },
            { "include": "#tailwindcss-important-prefix" }
          ]
        }
      },
      "match": "([^\\s]+)",
      "name": "support.type.property-name.css.tailwindcss"
    },
    "tailwindcss-class-with-variants": {
      "patterns": [
        { "include": "#tailwindcss-negative-prefix" },
        { "include": "#tailwindcss-variant" },
        { "include": "#tailwindcss-class" }
      ]
    },
    "tailwindcss-important-prefix": {
      "captures": {
        "1": {
          "name": "keyword.other.important.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "important.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "(!(?=\\w))"
    },
    "tailwindcss-negative-prefix": {
      "captures": {
        "1": {
          "name": "keyword.operator.arithmetic.css.tailwindcss"
        }
      },
      "match": "(-(?=\\w))"
    },
    "tailwindcss-variant": {
      "captures": {
        "1": {
          "name": "keyword.control.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "variant.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "([\\w-]+:)"
    },
    "whitespace": {
      "captures": {
        "1": {
          "name": "punctuation.whitespace.css.tailwindcss",
          "patterns": [
            {
              "match": "(.*)",
              "name": "whitespace.custom.tailwindcss"
            }
          ]
        }
      },
      "match": "(_)"
    }
  },
  "scopeName": "source.tailwindcss"
}
